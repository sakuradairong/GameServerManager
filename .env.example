# Packaged/service runtime defaults (working directory: project root)
SERVER_PORT=3001
NODE_ENV=production
LOG_LEVEL=info
DEV_MODE=false

# Restrict these values to the actual panel origin in production.
CORS_ORIGIN=http://localhost:3001
SOCKET_CORS_ORIGIN=http://localhost:3001

DATA_DIR=./data
LOG_DIR=./logs
GAME_DATA_DIR=./data/games

PTY_TIMEOUT=1800000
PTY_MAX_SESSIONS=0
GAME_MAX_INSTANCES=0

SYSTEM_MONITOR_INTERVAL=5000
SYSTEM_STATS_HISTORY_SIZE=720

ALERT_CPU_WARNING=70
ALERT_CPU_CRITICAL=90
ALERT_MEMORY_WARNING=80
ALERT_MEMORY_CRITICAL=95
ALERT_DISK_WARNING=85
ALERT_DISK_CRITICAL=95

JAVA_HOME=
JAVA_OPTS=-Xmx2G -Xms1G

BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION=7
REQUEST_TIMEOUT=0
